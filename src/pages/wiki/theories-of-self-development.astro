---
import '../../styles/global.css';

export const title = "5.1 Theories of Self-Development";
export const pageCategory = "content";
export const badgeClass = "badge-neutral";
export const links: string[] = [
  "socialization",
  "self",
  "looking-glass-self",
  "preparatory-stage",
  "play-stage",
  "game-stage",
  "generalized-other",
  "moral-development",
  "preconventional",
  "conventional",
  "postconventional",
  "justice-perspective",
  "care-and-responsibility-perspective",
  "gender-socialization",
  "sigmund-freud",
  "erik-erikson",
  "jean-piaget",
  "harry-harlow",
  "george-herbert-mead",
  "lawrence-kohlberg",
  "carol-gilligan",
  "charles-cooley",
];

const siteTitle = 'SAGreenXYZ';
const mySlug = 'theories-of-self-development';
const allPages = import.meta.glob<{ title?: string; pageCategory?: string; badgeClass?: string; links?: string[] }>('./*.astro', { eager: true });
const pageTerms = links.map(slug => ({
  slug,
  title: allPages[`./${slug}.astro`]?.title ?? slug,
  badgeClass: allPages[`./${slug}.astro`]?.badgeClass ?? 'badge-ghost',
  pageCategory: allPages[`./${slug}.astro`]?.pageCategory ?? 'concept',
}));
const categories = [...new Map(pageTerms.map(t => [t.pageCategory, t.badgeClass])).entries()]
  .map(([category, badgeClass]) => ({ category, badgeClass }));
const backlinks = Object.entries(allPages)
  .filter(([, mod]) => mod.links?.includes(mySlug))
  .map(([p, mod]) => ({
    slug: p.replace('./', '').replace('.astro', ''),
    title: mod.title ?? p.replace('./', '').replace('.astro', ''),
  }))
  .sort((a, b) => a.title.localeCompare(b.title));
---

<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>5.1 Theories of Self-Development — {siteTitle}</title>
  </head>
  <body>
    <!-- Navbar -->
    <div class="navbar bg-base-100 shadow-sm">
      <div class="navbar-start">
        <a href="/" class="btn btn-ghost text-xl">{siteTitle}</a>
      </div>
      <div class="navbar-end">
        <a href="/wiki" class="btn btn-ghost btn-sm">Wiki</a>
      </div>
    </div>

    <main class="container mx-auto px-4 py-12 max-w-3xl">

      <!-- Breadcrumbs -->
      <div class="breadcrumbs text-sm mb-4">
        <ul>
          <li><a href="/">Home</a></li>
          <li><a href="/wiki">Wiki</a></li>
          <li>5.1 Theories of Self-Development</li>
        </ul>
      </div>

      <!-- Title -->
      <div class="flex items-center gap-3 mb-2">
        <span class="badge badge-secondary">5.1</span>
        <h1 class="text-4xl font-bold">Theories of Self-Development</h1>
      </div>
      <p class="text-base-content/60 mb-8">Sociology — Psychological and sociological perspectives on how the self develops through social interaction.</p>

      <!-- Learning Objectives -->
      <div class="card bg-base-200 mb-10">
        <div class="card-body">
          <h2 class="card-title text-lg">Learning Objectives</h2>
          <p class="text-sm text-base-content/70 mb-2">By the end of this section, you should be able to:</p>
          <ul class="list-disc list-inside space-y-1 text-sm">
            <li>Differentiate psychological and sociological theories of self-development</li>
            <li>Explain the process of moral development</li>
          </ul>
        </div>
      </div>

      <!-- Intro -->
      <section class="mb-10">
        <p>When we are born, we have a genetic makeup and biological traits. However, who we are as human beings develops through social interaction. Many scholars — in both psychology and sociology — have described the process of self-development as a precursor to understanding how that "self" becomes socialized.</p>
      </section>

      <div class="divider"></div>

      <!-- Psychological Perspectives -->
      <section class="mb-10">
        <h2 class="text-2xl font-bold mb-4">Psychological Perspectives on Self-Development</h2>

        <!-- Comparison callout -->
        <div class="alert alert-info mb-6">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M12 2a10 10 0 100 20A10 10 0 0012 2z" />
          </svg>
          <div>
            <h4 class="font-bold">Sociology vs. Psychology</h4>
            <p class="text-sm mt-1"><strong>Psychologists</strong> look <em>inward</em> — mental health, emotional processes, how the mind influences behavior. <strong>Sociologists</strong> look <em>outward</em> — social institutions, cultural norms, interactions with others. Émile Durkheim was the first to make this distinction, attributing differences in suicide rates to social causes rather than psychological ones (1897).</p>
          </div>
        </div>

        <div class="grid sm:grid-cols-2 gap-4 mb-6">
          <div class="card bg-base-200">
            <div class="card-body">
              <h3 class="card-title text-base">Sigmund Freud (1856–1939)</h3>
              <p class="text-sm">Divided maturation into stages; posited that self-development is closely linked to early stages. Failure to properly engage in or disengage from a specific stage results in emotional and psychological consequences throughout adulthood.</p>
            </div>
          </div>
          <div class="card bg-base-200">
            <div class="card-body">
              <h3 class="card-title text-base">Erik Erikson (1902–1994)</h3>
              <p class="text-sm">Eight stages of development from birth to death. Unlike Freud, Erikson believed personality continued to change over time and credited social aspects — negotiating between base desires and social acceptance (Erikson 1982).</p>
            </div>
          </div>
          <div class="card bg-base-200">
            <div class="card-body">
              <h3 class="card-title text-base">Jean Piaget (1896–1980)</h3>
              <p class="text-sm">Focused on the role of social interactions in child development. Self evolved through a negotiation between the world as it exists in one's mind and the world as experienced socially (Piaget 1954).</p>
            </div>
          </div>
          <div class="card bg-base-200">
            <div class="card-body">
              <h3 class="card-title text-base">Harry Harlow (1905–1981)</h3>
              <p class="text-sm">Studied the role of social relationships via isolation and maternal deprivation in young rhesus monkeys. Isolated monkeys exhibited self-harm and difficulty integrating. Cloth surrogate mothers provided emotional support; wire mothers did not.</p>
            </div>
          </div>
        </div>
      </section>

      <div class="divider"></div>

      <!-- Sociological Theories -->
      <section class="mb-10">
        <h2 class="text-2xl font-bold mb-4">Sociological Theories of Self-Development</h2>

        <p class="mb-4">Charles Cooley (1864–1929) asserted that people's self-understanding is constructed in part by their perception of how others view them — the <strong>looking-glass self</strong> (Cooley 1902).</p>

        <p class="mb-4">George Herbert Mead (1863–1931) studied the <strong>self</strong> — a person's distinct identity developed through social interaction. To develop a sense of self, an individual must be able to view themselves through the eyes of others, a skill gained through socialization (Mead 1934).</p>

        <p class="mb-4">Mead described a specific path of development:</p>

        <ul class="steps steps-vertical mb-6">
          <li class="step step-success">
            <div class="text-left ml-4">
              <strong>Preparatory stage</strong> — Children can only imitate. No ability to imagine how others see things. They copy actions of caregivers.
            </div>
          </li>
          <li class="step step-success">
            <div class="text-left ml-4">
              <strong>Play stage</strong> — Children begin to take on the role of one other person. Playing dress-up as "mom" or talking on a toy phone the way adults do.
            </div>
          </li>
          <li class="step step-success">
            <div class="text-left ml-4">
              <strong>Game stage</strong> — Children learn to consider several roles simultaneously and how those roles interact. Understanding a restaurant requires a host, server, cook, and busser working together.
            </div>
          </li>
          <li class="step step-success">
            <div class="text-left ml-4">
              <strong>Generalized other</strong> — Understanding the common behavioral expectations of general society. An individual can now imagine how they are viewed by one or many others — and thus has a "self" (Mead 1934).
            </div>
          </li>
        </ul>
      </section>

      <div class="divider"></div>

      <!-- Moral Development -->
      <section class="mb-10">
        <h2 class="text-2xl font-bold mb-4">Moral Development</h2>

        <p class="mb-4"><strong>Moral development</strong> is how people learn what society considers "good" and "bad" — essential for a smoothly functioning society. Lawrence Kohlberg (1927–1987) developed a theory with three levels:</p>

        <div class="overflow-x-auto mb-6">
          <table class="table table-zebra w-full">
            <thead>
              <tr>
                <th>Level</th>
                <th>Age / Stage</th>
                <th>Characteristic</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>Preconventional</strong></td>
                <td>Young children</td>
                <td>Experience world through senses; limited cognitive ability</td>
              </tr>
              <tr>
                <td><strong>Conventional</strong></td>
                <td>Teen years</td>
                <td>Increasingly aware of others' feelings; considers what's "good" and "bad"</td>
              </tr>
              <tr>
                <td><strong>Postconventional</strong></td>
                <td>Adulthood</td>
                <td>Abstract morality; recognizes legality and morality do not always align</td>
              </tr>
            </tbody>
          </table>
        </div>

        <h3 class="text-xl font-semibold mb-3">Gilligan's Critique: Moral Development and Gender</h3>

        <p class="mb-4">Carol Gilligan (1936–) recognized that Kohlberg's research was conducted only on male subjects and questioned whether females would respond differently. Her research suggested:</p>

        <div class="grid sm:grid-cols-2 gap-4 mb-4">
          <div class="card bg-base-200">
            <div class="card-body">
              <h4 class="card-title text-base">Boys: Justice Perspective</h4>
              <p class="text-sm">Emphasis on rules and laws. Socialized for a work environment where rules make operations run smoothly.</p>
            </div>
          </div>
          <div class="card bg-base-200">
            <div class="card-body">
              <h4 class="card-title text-base">Girls: Care &amp; Responsibility Perspective</h4>
              <p class="text-sm">Considers people's reasons behind behavior. Socialized for a home environment where flexibility allows for harmony in caretaking.</p>
            </div>
          </div>
        </div>

        <div class="alert alert-warning mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z" />
          </svg>
          <div>
            <p class="text-sm">Gilligan's study has been scientifically discredited due to its small sample size, and results have not been replicated. The differences she observed reflect <strong>gender socialization</strong> — societal expectations of how boys and girls should behave — rather than fundamentally different moral development pathways.</p>
          </div>
        </div>

        <!-- Real World callout -->
        <div class="alert alert-info">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M12 2a10 10 0 100 20A10 10 0 0012 2z" />
          </svg>
          <div>
            <h4 class="font-bold">Sociology in the Real World — What a Pretty Little Lady!</h4>
            <p class="text-sm mt-1">Lisa Bloom (author of <em>Think</em>) notes that adults disproportionately comment on girls' appearance rather than their interests or intellect, socializing them to believe looks are of vital importance — about 50% of girls ages 3–6 worry about being fat (Bloom 2011). The Egalia preschool in Sweden experiments with a genderless environment: children are referred to with neutral terms like "friend," and toys and play areas are designed to avoid reinforcing gender expectations.</p>
          </div>
        </div>
      </section>

      <div class="divider"></div>

      <!-- Concordance -->
      <section class="mb-10">
        <div class="collapse collapse-arrow bg-base-200">
          <input type="checkbox" />
          <div class="collapse-title text-xl font-semibold">
            Concordance <span class="text-sm font-normal text-base-content/50 ml-2">({pageTerms.length} terms)</span>
          </div>
          <div class="collapse-content">
            <div class="flex flex-wrap gap-2 mb-4 pt-2">
              {categories.map(({ category, badgeClass }) => (
              <span class={`badge ${badgeClass} badge-sm`}>{category}</span>
            ))}
            </div>
            <div class="flex flex-wrap gap-2">
              {pageTerms.map(t => (
                <a href={`/wiki/${t.slug}`} class={`badge ${t.badgeClass} hover:opacity-80`}>{t.title}</a>
              ))}
            </div>
          </div>
        </div>
      </section>

      {backlinks.length > 0 && <div class="divider"></div>}
      {backlinks.length > 0 && (
        <section>
          <h2 class="text-lg font-semibold mb-3">Referenced by</h2>
          <div class="flex flex-wrap gap-2">
            {backlinks.map(bl => (
              <a href={`/wiki/${bl.slug}`} class="btn btn-sm btn-ghost">{bl.title}</a>
            ))}
          </div>
        </section>
      )}
    </main>
  </body>
</html>
