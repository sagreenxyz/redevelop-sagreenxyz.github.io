---
import '../../styles/global.css';

export const title = "4.2 Theoretical Perspectives on Society";
export const pageCategory = "content";
export const badgeClass = "badge-neutral";
export const links: string[] = [
  "functionalism",
  "conflict-theory",
  "symbolic-interactionism",
  "mile-durkheim",
  "karl-marx",
  "max-weber",
  "collective-conscience",
  "social-integration",
  "mechanical-solidarity",
  "organic-solidarity",
  "anomie",
  "social-facts",
  "division-of-labor",
  "base-and-superstructure",
  "bourgeoisie",
  "proletariat",
  "alienation",
  "false-consciousness",
  "class-consciousness",
  "means-of-production",
  "rationalization",
  "iron-cage",
  "protestant-work-ethic",
  "predestination",
  "capitalism",
  "social-class",
  "social-mobility",
  "industrialization",
  "industrial-revolution",
];

const siteTitle = 'SAGreenXYZ';
const mySlug = 'theoretical-perspectives-on-society';
const allPages = import.meta.glob<{ title?: string; pageCategory?: string; badgeClass?: string; links?: string[] }>('./*.astro', { eager: true });
const pageTerms = links.map(slug => ({
  slug,
  title: allPages[`./${slug}.astro`]?.title ?? slug,
  badgeClass: allPages[`./${slug}.astro`]?.badgeClass ?? 'badge-ghost',
  pageCategory: allPages[`./${slug}.astro`]?.pageCategory ?? 'concept',
}));
const categories = [...new Map(pageTerms.map(t => [t.pageCategory, t.badgeClass])).entries()]
  .map(([category, badgeClass]) => ({ category, badgeClass }));
const backlinks = Object.entries(allPages)
  .filter(([, mod]) => mod.links?.includes(mySlug))
  .map(([p, mod]) => ({
    slug: p.replace('./', '').replace('.astro', ''),
    title: mod.title ?? p.replace('./', '').replace('.astro', ''),
  }))
  .sort((a, b) => a.title.localeCompare(b.title));
---

<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>4.2 Theoretical Perspectives on Society — {siteTitle}</title>
  </head>
  <body>
    <!-- Navbar -->
    <div class="navbar bg-base-100 shadow-sm">
      <div class="navbar-start">
        <a href="/" class="btn btn-ghost text-xl">{siteTitle}</a>
      </div>
      <div class="navbar-end">
        <a href="/wiki" class="btn btn-ghost btn-sm">Wiki</a>
      </div>
    </div>

    <main class="container mx-auto px-4 py-12 max-w-3xl">

      <!-- Breadcrumbs -->
      <div class="breadcrumbs text-sm mb-4">
        <ul>
          <li><a href="/">Home</a></li>
          <li><a href="/wiki">Wiki</a></li>
          <li>4.2 Theoretical Perspectives on Society</li>
        </ul>
      </div>

      <!-- Title -->
      <div class="flex items-center gap-3 mb-2">
        <span class="badge badge-secondary">4.2</span>
        <h1 class="text-4xl font-bold">Theoretical Perspectives on Society</h1>
      </div>
      <p class="text-base-content/60 mb-8">Sociology — Functionalism, conflict theory, and symbolic interactionism.</p>

      <!-- Learning Objectives -->
      <div class="card bg-base-200 mb-10">
        <div class="card-body">
          <h2 class="card-title text-lg">Learning Objectives</h2>
          <p class="text-sm text-base-content/70 mb-2">By the end of this section, you should be able to:</p>
          <ul class="list-disc list-inside space-y-1 text-sm">
            <li>Describe Durkheim's functionalist view of society</li>
            <li>Summarize the conflict theorist view of society</li>
            <li>Explain Marx's concepts of class and alienation</li>
            <li>Identify how symbolic interactionists understand society</li>
          </ul>
        </div>
      </div>

      <!-- Introduction -->
      <section class="mb-10">
        <p>While many sociologists have contributed to research on society and social interaction, three thinkers form the base of modern-day perspectives. Émile Durkheim, Karl Marx, and Max Weber developed different theoretical approaches to help us understand the way societies function.</p>
      </section>

      <div class="divider"></div>

      <!-- Durkheim -->
      <section class="mb-10">
        <h2 class="text-2xl font-bold mb-4">Émile Durkheim and Functionalism</h2>

        <p class="mb-4">As a functionalist, Émile Durkheim's (1858–1917) perspective on society stressed the necessary interconnectivity of all of its elements. To Durkheim, society was greater than the sum of its parts. He asserted that individual behavior was not the same as collective behavior and that studying collective behavior was quite different from studying an individual's actions. Durkheim called the communal beliefs, morals, and attitudes of a society the <strong>collective conscience</strong>. He also believed that <strong>social integration</strong>, or the strength of ties that people have to their social groups, was a key factor in social life.</p>

        <p class="mb-4">Following the ideas of Comte and Spencer, Durkheim likened society to a living organism, in which each organ plays a necessary role in keeping the being alive. Even the socially deviant members of society are necessary, Durkheim argued, as punishments for deviance affirm established cultural values and norms. Durkheim called these elements of society "social facts" — social forces that were real and existed outside the individual.</p>

        <p class="mb-4">His primary concern was that the cultural glue that held society together was failing. In <em>The Division of Labor in Society</em> (1893), Durkheim argued that as society grew more complex, social order made the transition from mechanical to organic.</p>

        <!-- Solidarity comparison -->
        <div class="grid sm:grid-cols-2 gap-4 mb-6">
          <div class="card bg-base-200">
            <div class="card-body">
              <h3 class="card-title text-base">Mechanical Solidarity</h3>
              <p class="text-sm">Social order maintained by the <strong>collective conscience</strong>. Common in preindustrial societies — strong kinship bonds, low division of labor, shared morals. People who do the same work tend to think and act alike.</p>
            </div>
          </div>
          <div class="card bg-base-200">
            <div class="card-body">
              <h3 class="card-title text-base">Organic Solidarity</h3>
              <p class="text-sm">Social order based on acceptance of <strong>economic and social differences</strong>. In industrial societies, specialization means everyone does different things. Laws are based on restitution rather than revenge.</p>
            </div>
          </div>
        </div>

        <p class="mb-4">While the transition from mechanical to organic solidarity is advantageous long-term, Durkheim noted it can produce <strong>anomie</strong> — literally "without law" — a situation in which society no longer has the support of a firm collective consciousness. Anomie is experienced in times of social uncertainty, such as war or major economic upheaval.</p>
      </section>

      <div class="divider"></div>

      <!-- Marx -->
      <section class="mb-10">
        <h2 class="text-2xl font-bold mb-4">Karl Marx and Conflict Theory</h2>

        <p class="mb-4">Karl Marx (1818–1883) saw society's constructions as predicated upon "base and superstructure": a society's economic character forms its base, upon which rests culture and social institutions — the superstructure. For Marx, the economy determines what a society will be like. He also saw <strong>conflict</strong> as the primary means of social change.</p>

        <p class="mb-4">Economically, Marx saw conflict between the owners of the means of production — the <strong>bourgeoisie</strong> — and the laborers — the <strong>proletariat</strong>. Most recently, with the end of feudalism, the bourgeoisie dominated the proletariat. In Marx's words: <em>"Society as a whole is more and more splitting up into two great hostile camps, into two great classes directly facing each other — Bourgeoisie and Proletariat"</em> (Marx and Engels 1848).</p>

        <p class="mb-4">As industrialization boomed in the mid-nineteenth century, industrial employers became increasingly exploitative. Frederick Engels described conditions in Manchester in 1844:</p>

        <blockquote class="border-l-4 border-base-content/30 pl-4 italic text-base-content/70 mb-6">
          "Such is the Old Town of Manchester, and on re-reading my description, I am forced to admit that instead of being exaggerated, it is far from black enough to convey a true impression of the filth, ruin, and uninhabitableness… containing at least twenty to thirty thousand inhabitants. And such a district exists in the heart of the second city of England, the first manufacturing city of the world."
        </blockquote>

        <p class="mb-4">Marx described modern society in terms of <strong>alienation</strong> — the condition in which the individual is isolated and divorced from their society, work, or sense of self. He identified four types:</p>

        <ul class="steps steps-vertical mb-6">
          <li class="step step-primary">
            <div class="text-left ml-4">
              <strong>From the product of labor</strong> — A worker has no relationship to what they produce. An assembly line worker installs one part without ever seeing the finished product.
            </div>
          </li>
          <li class="step step-primary">
            <div class="text-left ml-4">
              <strong>From the process of labor</strong> — A worker does not control the conditions of their job because they don't own the means of production. There is no room for creativity or change.
            </div>
          </li>
          <li class="step step-primary">
            <div class="text-left ml-4">
              <strong>From others</strong> — Workers compete rather than cooperate — for time slots, bonuses, and job security.
            </div>
          </li>
          <li class="step step-primary">
            <div class="text-left ml-4">
              <strong>From self</strong> — No connection between a worker and their labor means no sense of self. A person becomes a cog in the machine rather than a craftsperson with an identity.
            </div>
          </li>
        </ul>

        <p class="mb-4">Marx also developed the concept of <strong>false consciousness</strong> — a condition in which a person's beliefs are not in their own best interest, but instead reflect the ideology of the dominant class. Workers are less likely to question their place in society. To overcome this, Marx proposed <strong>class consciousness</strong> — awareness of one's rank in society. The proletariat must become a "class for itself" to produce social change.</p>
      </section>

      <div class="divider"></div>

      <!-- Weber -->
      <section class="mb-10">
        <h2 class="text-2xl font-bold mb-4">Max Weber and Symbolic Interactionism</h2>

        <p class="mb-4">Max Weber is one of the greatest influences in the field of sociology. Like Marx, Weber saw class as economically determined — society split between owners and laborers. But Weber also emphasized status (based on noneconomic factors such as education, kinship, and religion) and power as equally important. Unlike Marx, Weber believed that <em>ideas</em> formed the base of society.</p>

        <p class="mb-4">Weber's analysis of modern society centered on <strong>rationalization</strong> — the organization of social and economic life around logic and efficiency rather than morality or tradition. To Weber, capitalism is entirely rational. Although this leads to efficiency and merit-based success, it can have negative effects at the extreme: rigid routines, mechanized work environments, and a focus on identical products everywhere.</p>

        <p class="mb-4">Weber was more interested in how individuals <em>experienced</em> societal divisions than in the divisions themselves. The culmination of industrialization and rationalization results in what he called the <strong>iron cage</strong> — the individual trapped by institutions and bureaucracy, leading to a "disenchantment of the world." In a rationalized society, supermarkets replace family-owned stores, chain restaurants replace local eateries, and superstores displace independent businesses.</p>

        <!-- Big Picture callout -->
        <div class="alert alert-success mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064" />
          </svg>
          <div>
            <h4 class="font-bold">Big Picture — The Protestant Work Ethic</h4>
            <p class="mt-1">In 1904, Weber presented the idea of the <em>Protestant work ethic</em>, rooted in the Calvinist principle of <strong>predestination</strong> — the idea that all events, including salvation, have already been decided by God. Because followers could never be certain of their salvation, they looked for signs in daily life: hard work and success indicated one was among the chosen. Weber argued this mentality encouraged people to work hard for personal gain and became the foundation for capitalism.</p>
          </div>
        </div>
      </section>

      <div class="divider"></div>

      <!-- Summary table -->
      <section class="mb-10">
        <h2 class="text-2xl font-bold mb-4">Summary</h2>
        <div class="overflow-x-auto">
          <table class="table table-zebra w-full">
            <thead>
              <tr>
                <th>Theorist</th>
                <th>Perspective</th>
                <th>Key Idea</th>
                <th>Core Concepts</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Émile Durkheim</td>
                <td>Functionalism</td>
                <td>Society is greater than the sum of its parts; elements are interconnected</td>
                <td>collective conscience, anomie, mechanical/organic solidarity</td>
              </tr>
              <tr>
                <td>Karl Marx</td>
                <td>Conflict Theory</td>
                <td>Economy determines society; class conflict drives change</td>
                <td>bourgeoisie, proletariat, alienation, false/class consciousness</td>
              </tr>
              <tr>
                <td>Max Weber</td>
                <td>Symbolic Interactionism</td>
                <td>Individuals experience society through meaning and rationalization</td>
                <td>rationalization, iron cage, Protestant work ethic, status</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <div class="divider"></div>

      <!-- Concordance -->
      <section class="mb-10">
        <div class="collapse collapse-arrow bg-base-200">
          <input type="checkbox" />
          <div class="collapse-title text-xl font-semibold">
            Concordance <span class="text-sm font-normal text-base-content/50 ml-2">({pageTerms.length} terms)</span>
          </div>
          <div class="collapse-content">
            <div class="flex flex-wrap gap-2 mb-4 pt-2">
              {categories.map(({ category, badgeClass }) => (
              <span class={`badge ${badgeClass} badge-sm`}>{category}</span>
            ))}
            </div>
            <div class="flex flex-wrap gap-2">
              {pageTerms.map(t => (
                <a href={`/wiki/${t.slug}`} class={`badge ${t.badgeClass} hover:opacity-80`}>{t.title}</a>
              ))}
            </div>
          </div>
        </div>
      </section>

      {backlinks.length > 0 && <div class="divider"></div>}
      {backlinks.length > 0 && (
        <section>
          <h2 class="text-lg font-semibold mb-3">Referenced by</h2>
          <div class="flex flex-wrap gap-2">
            {backlinks.map(bl => (
              <a href={`/wiki/${bl.slug}`} class="btn btn-sm btn-ghost">{bl.title}</a>
            ))}
          </div>
        </section>
      )}
    </main>
  </body>
</html>
